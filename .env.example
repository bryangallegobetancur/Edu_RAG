# Modelo de embeddings local (descarga automática ~80 MB)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Alternativas:
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2  (~420 MB, soporta español)
# EMBEDDING_MODEL=intfloat/multilingual-e5-small          (~120 MB, multilenguaje ligero)

# LLM local con Ollama (default)
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# LLM en la nube con opencode-go (DeepSeek V4 Flash)
# LLM_PROVIDER=opencode-go
# OPENCODE_GO_API_KEY=sk-...
# OPENCODE_GO_MODEL=deepseek-v4-flash
# OPENCODE_GO_BASE_URL=https://api.opencode.ai/v1

# LLM OpenAI (alternativa)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# LangSmith tracing (obtén tu API key en https://smith.langchain.com)
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=lsv2_...
# LANGCHAIN_PROJECT=mi-rag
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# LLM as a Judge (para evaluación en LangSmith)
# Por defecto reutiliza el provider opencode-go (mismas API key y base_url de arriba)
JUDGE_PROVIDER=opencode-go
JUDGE_MODEL=qwen3.7-plus
JUDGE_TEMPERATURE=0
# Dataset y experimento de evaluación en LangSmith
LANGSMITH_EVAL_DATASET=RAG_eval_qa
LANGSMITH_EVAL_EXPERIMENT=rag-eval
