{
  "builds": [
    {
      "src": "api/server.py",
      "use": "@vercel/python",
      "config": { "runtime": "python3.12" }
    },
    {
      "src": "web/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/server.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "web/$1" }
  ]
}
